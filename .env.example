# ── 공개 (클라이언트 번들에 인라인됨) ──────────────────────────────
# Cloudflare Turnstile site key
# 로컬 개발용 더미 키(항상 통과, invisible): 1x00000000000000000000BB
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것) ─────────────
# Turnstile secret key
# 로컬 개발용 더미 키(항상 통과): 1x0000000000000000000000000000000AA
# 프로덕션에서 비어 있으면 댓글 작성이 모두 거부된다 (fail closed).
TURNSTILE_SECRET_KEY=

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 관리자: 이 비밀번호로 예약 닉네임 사용 + 모든 댓글 삭제가 가능하다
ADMIN_PASSWORD=
OWNER_NICKNAME=sunny

# IP 해싱용 솔트. openssl rand -hex 32
IP_HASH_SALT=

# 선택. 새 댓글 알림
DISCORD_WEBHOOK_URL=
